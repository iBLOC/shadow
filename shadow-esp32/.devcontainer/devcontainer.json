{
	"name": "shadow-esp32 (Zephyr)",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash"
			},
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cmake-tools",
				"twxs.cmake",
				"nordic-semiconductor.nrf-connect"
			]
		}
	},
	"runArgs": ["--privileged"],
	"postCreateCommand": "west init -l . && west update && west packages pip --install"
}