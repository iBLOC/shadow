{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "strict": true,
    "noEmit": false,
    "outDir": "node_modules/.cache/tsbuild-node"
  },
  "include": ["vite.config.ts", "vite.config.web.ts"]
}
