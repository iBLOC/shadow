    "@modelcontextprotocol/sdk": "^1.0.0",
    "zustand": "^5.0.2",
    "lucide-react": "^0.469.0",
    "date-fns": "^4.1.0",
    "zod": "^3.24.1",
    "i18next": "^24.2.2",
    "react-i18next": "^15.4.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "@tauri-apps/cli": "^2",
