{
  "name": "shadow-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --config vite.config.web.ts",
    "build": "tsc -b && vite build",
    "build:web": "tsc --noEmit && vite build --config vite.config.web.ts --mode web",
    "preview": "vite preview",
