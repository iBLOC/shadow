{
  "name": "shadow-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --config vite.config.web.ts",
    "test:api": "node tests/api-contract/scrape-endpoints.mjs && vitest run --config vitest.api.config.ts",
    "prebuild": "pnpm test:api",
    "prebuild:web": "pnpm test:api",
    "build": "tsc -b && vite build",
    "build:web": "tsc --noEmit && vite build --config vite.config.web.ts --mode web",
    "preview": "vite preview",
    "preview:web": "vite preview --config vite.config.web.ts --port 4173 --host 0.0.0.0",
    "lint": "eslint .",
    "tauri": "tauri",
    "test:smoke": "bash scripts/ui-smoke.sh",
    "test:pre-push": "bash scripts/pre-push.sh",
    "test:e2e": "cd e2e-tests && xvfb-run pnpm test",
    "test:e2e:setup": "cd e2e-tests && pnpm install",
    "test:wdio": "wdio run tests/wdio/wdio.conf.ts",
    "test:wdio:conversation": "wdio run tests/wdio/wdio.conf.ts --spec tests/wdio/conversation.test.ts",
    "test:wdio:pages": "wdio run tests/wdio/wdio.conf.ts --spec tests/wdio/pages.test.ts",
    "test:wdio:api": "wdio run tests/wdio/wdio.conf.ts --spec tests/wdio/api.test.ts",
    "test:tauri:build": "cargo build --manifest-path src-tauri/Cargo.toml",
    "test:tauri:xvfb-check": "which xvfb-run || (echo 'Install xvfb: sudo apt install xvfb' && exit 1)",
    "test:tauri": "pnpm test:tauri:xvfb-check && pnpm test:tauri:build && bash -c 'if [ \"$SHADOW_USE_XVFB\" = \"1\" ] || ([ \"$(uname)\" = \"Linux\" ] && [ -z \"$DISPLAY\" ]); then xvfb-run -a wdio run wdio.conf.tauri.ts; else wdio run wdio.conf.tauri.ts; fi'",
    "test:tauri:headed": "pnpm test:tauri:build && wdio run wdio.conf.tauri.ts",
    "test:tauri:reuse": "SHADOW_TAURI_REUSE=1 SHADOW_USE_XVFB=1 xvfb-run -a wdio run wdio.conf.tauri.ts",
    "test:tauri:spec": "wdio run wdio.conf.tauri.ts --spec"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.80",
    "@ai-sdk/ui-utils": "^1.2.11",
    "@google/design.md": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@shadcn/helpers": "^0.2.0",
    "@shadcn/react": "^0.3.0",
    "@tanstack/ai": "^0.40.0",
    "@tanstack/ai-client": "^0.20.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-notification": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2",
    "dmn-js": "^17.12.3",
    "@univerjs/core": "0.6.10",
    "@univerjs/presets": "^0.6.0",
    "@univerjs/sheets": "^0.6.0",
    "ai": "^7.0.0",
    "date-fns": "^4.1.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "i18next": "^24.2.2",
    "lucide-react": "^0.469.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.4.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^7.1.1",
    "remark-gfm": "^4.0.1",
    "swr": "^2.4.1",
    "throttleit": "^2.1.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/ui": "^3.1.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/globals": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "@wdio/types": "^9.31.2",
    "autoprefixer": "^10.5.1",
    "chromedriver": "^131.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.0.0",
    "eslint-plugin-i18next": "^6.1.0",
    "eslint-plugin-i18next-no-undefined-translation-keys": "^3.4.0",
    "eslint-plugin-react": "^4.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.5.15",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.1.0",
    "wdio-chromedriver-service": "^8.0.0"
  }
}