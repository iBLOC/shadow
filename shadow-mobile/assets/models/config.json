{
    "llm_model": "qwen2.5-0.5b.mnn",
    "llm_weight": "qwen2.5-0.5b.mnn.weight",
    "llm_config": "llm_config.json",
    "tokenizer_file": "tokenizer.txt",
    "backend_type": "cpu",
    "thread_num": 4,
    "precision": "low",
    "memory": "low",
    "sampler_type": "mixed",
