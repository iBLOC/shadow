# Shadow benchmark host environment (local only - never commit a real
# .env; copy this file and fill your keys).
# api_key_env in agents.toml resolves these names at request time;
# api_key (inline) still wins if set, but prefer env. Keys never enter
# git, the benchmark report, or any logs.
#
# Run order:
#   1. copy this file:     cp .env.example .env  (then edit .env)
#   2. source it:          set -a; source .env; set +a
#                         (or use any dotenv loader you prefer)
#   3. launch benchmark:   cd benchmark && cargo run -- run ...

# Official-benchmark model keys

# Anthropic (Claude Opus 4.5 - OpenHands / OpenCode harness model)
SHADOW_BENCH_ANTHROPIC_KEY=

# OpenAI (GPT - Codex harness model, Terminal-Bench top entry)
SHADOW_BENCH_OPENAI_KEY=

# Zhipu AI (GLM 5 - Terminus 2 harness model, TB 2.0 52.4%)
SHADOW_BENCH_ZHIPU_KEY=

# Alibaba DashScope (Qwen3 Max - SWE-bench Verified 72.5 / tau2-Verified 69.6)
SHADOW_BENCH_DASHSCOPE_KEY=

# DeepSeek (V3 / V3.x - open-weights reference)
SHADOW_BENCH_DEEPSEEK_KEY=

# Brain host knobs (independent of model keys)

# Encephalon boot port (default 8082). The binary and the embedded
# host bind the same default; change when a port is taken.
ENCEPHALON_BRAIN_PORT=8082

# Default model for every registered lobe (Temporal / Prefrontal /
# Parietal / Occipital). Resolved by encephalon at boot.
ENCEPHALON_DEFAULT_MODEL=

# Per-lobe override: "temporal=qwen3-max,occipital=claude-opus-4-5,..."
# Lobe names without an entry fall back to ENCEPHALON_DEFAULT_MODEL.
ENCEPHALON_LOBE_MODELS=

# Set when DATASOURCE_URL isn't a Postgres connection - the brain's
# Hippocampus backend boots in-memory mode instead.
HIPPOCAMPUS_INMEMORY_ONLY=0

# shadow-desktop knobs (Tauri shell, when running benchmark as the
# shadow-desktop adapter - requires pnpm tauri dev to be running)

# The wdio WebDriver URL the benchmark driver talks to. Default when
# pnpm tauri dev is running locally.
SHADOW_BENCH_WDIO_URL=http://127.0.0.1:4445
SHADOW_BENCH_APP_URL=http://localhost:1420

# Optional judge (LLM-as-judge scorers need this)
# SHADOW_BENCH_JUDGE_BASE_URL=
# SHADOW_BENCH_JUDGE_KEY=
# SHADOW_BENCH_JUDGE_MODEL=gpt-4o
