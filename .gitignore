# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
dist-web/
build/
out/

# Vite / TypeScript incremental cache
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# Rust build outputs
target/
Cargo.lock
# ⚠️ 桌面端的锁**要入库**（其余 Rust 仓的锁照旧忽略）——
#    桌面端是**发布产物**：没有锁 ⇒ ⇒ CI 每次都重新解析 crates.io ⇒ ⇒
#    上游一发布新版依赖就会把发布打掉（实测：a2a 家族发了 0.5.x ⇒ ⇒
#    synapse 的 `a2a::A2AError` 形状变了 ⇒ ⇒ 整条桌面端构建死在
#    "could not compile `synapse`"）⇒ ⇒ ⇒ 而且同一个 tag 两次发布会得到
#    **不同的二进制** ⇒ ⇒ ⇒ ⇒ ⇒ ⇒ ⇒ ⇒ 钉住 ⇒ ⇒ 发布才可复现。
!shadow-desktop/src-tauri/Cargo.lock

# Android
*.apk
*.aab
.gradle/
*.jar
# ⚠️ gradle wrapper 的 jar **要入库**（v2.9 销债）—— CI 的 mobile-test 跑
#    `./gradlew :app:testDebugUnitTest`，wrapper 不入库它永远 exit 127。
#    （上面那条 `*.jar` 是防构建产物；例外只开 wrapper 这一个文件。）
!shadow-mobile/android/gradle/wrapper/gradle-wrapper.jar
*.class
*.dex
*.jks
*.keystore

# iOS
*.ipa
*.dSYM
*.xcuserdata
*.xcworkspace

# Flutter
.packages
.pub-cache/
.pub/
.flutter-plugins
.flutter-plugins-dependencies
.dart_tool/
# pubspec.lock 是故意不忽略的: Flutter 应用应该提交 lockfile,
# 否则每次 CI 都要重新解析依赖, 构建不可复现。

# MNN / Model files
*.mnn
*.onnx
*.pt
*.bin

# 本地构建出来的原生库（prefrontal 的嵌入式大脑）。
# 由 prefrontal/scripts/build-android.sh 生成 —— 那是兄弟仓库源码的
# 构建产物，40MB/ABI，不入库；需要时跑一次脚本即可。
# （jniLibs 里的 MNN 那几个是 vendored 第三方二进制，仍然入库。）
shadow-mobile/android/app/src/main/jniLibs/*/libprefrontal_core_lib.so

# 本地构建出来的原生库（encephalon 的嵌入式大脑）。
# 由 encephalon/scripts/build-android.ps1 生成 —— 同样是兄弟仓库源码的
# 构建产物，按 ABI 体积不小，不入库；需要时跑一次脚本即可。
shadow-mobile/android/app/src/main/jniLibs/*/libencephalon.so

