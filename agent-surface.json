  "_containers": {
    "_note": "容器路由不是能力本身 —— 它们把一组能力聚合到一个入口。",
    "mobile": [
      { "route": "/manage", "labelKey": "surface.manage", "holds": ["agents", "models", "providers", "mcp", "skills", "memory"] }
    ]
  },

  "_legacyRoutes": {
    "_note": "兼容旧 deep link 的重定向，不是能力入口。桌面端暂无。",
    "mobile": ["/agents", "/models", "/providers", "/mcp", "/skills", "/memory"]
  },

  "_runtime": {
    "source": "端脑（telencephalon）",
    "endpoints": {
      "agents": "GET /shadow/v1/agents",
      "agentCard": "GET /.well-known/agent.json",
      "conversation": "GET/POST /shadow/v1/conversations"
    },
    "note": "能力是否**可用**由端脑运行时决定：lobe 的 enabled + health_status + agent_card.metadata.capabilities。注意 native lobe 的 skills[] 目前是空数组，能力标识实际在 agent_card.metadata.capabilities[] 与 config.required_capabilities 里 —— 接运行时状态前要先统一这两个字段的语义。"
  }
